# Kopiere diese Datei nach .env und fülle die Keys ein.
# .env wird NICHT ins Git committed (siehe .gitignore)

ANTHROPIC_API_KEY=sk-ant-...
TRADIER_API_KEY=...
NEWS_API_KEY=...

# External-Data Factory (modules/external/) — optional, nur für Quellen mit
# requires_auth: true in config/external_sources/*.yaml
ESTAT_APP_ID=
FRED_API_KEY=

# Optional: GENESIS-Online-Konto (Destatis). Ohne Angabe wird der anonyme Gastzugang genutzt.
DESTATIS_USER=
DESTATIS_PASSWORD=
