# Kopiere diese Datei nach .env und fülle die Keys ein.
# .env wird NICHT ins Git committed (siehe .gitignore)

ANTHROPIC_API_KEY=sk-ant-...
TRADIER_API_KEY=...
NEWS_API_KEY=...

# External-Data Factory (modules/external/) — optional, nur für Quellen mit
# requires_auth: true in config/external_sources/*.yaml
ESTAT_APP_ID=
FRED_API_KEY=

# Optional: GENESIS-Online-Konto (Destatis). Ohne Angabe wird der anonyme Gastzugang genutzt.
DESTATIS_USER=
DESTATIS_PASSWORD=

# Optional: kostenloser NCEI-CDO-Token (Stationssuche für Klimanormalwerte)
NCEI_CDO_TOKEN=
# Kontakt im NWS-User-Agent (vom NWS verlangt), z.B. E-Mail-Adresse
NWS_USER_AGENT_CONTACT=

# Optional: Object-Storage-Backend für das externe PIT-Archiv
# (external_context.archive.backend: s3 in config.yaml). Ohne
# EXTERNAL_ARCHIVE_S3_BUCKET bleibt backend: s3 wirkungslos (kein Upload,
# keine Löschung). Funktioniert mit jedem S3-kompatiblen Store (AWS S3,
# Cloudflare R2, Backblaze B2, MinIO, …) — siehe modules/external/storage.py.
EXTERNAL_ARCHIVE_S3_BUCKET=
EXTERNAL_ARCHIVE_S3_ENDPOINT=
EXTERNAL_ARCHIVE_S3_PREFIX=adaptive-asymmetry/external_data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
